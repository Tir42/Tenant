{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TenantSnap (Android Emulator)",
            "request": "launch",
            "type": "dart",
            "deviceId": "android"
        },
        {
            "name": "TenantSnap (Web Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome"
        },
        {
            "name": "TenantSnap (Windows Desktop)",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows"
        },
        {
            "name": "TenantSnap (Debug - Auto)",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "TenantSnap (Profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "TenantSnap (Release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome against localhost",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}